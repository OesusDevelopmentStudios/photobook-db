#
# Podman Quadlet unit: systemd runs photobook-db as a service. For a rootless setup, copy this file to
# ~/.config/containers/systemd/ and run:
#
#   systemctl --user daemon-reload
#   systemctl --user start photobook-db
#
# To start it at boot without logging in: loginctl enable-linger $USER
# To install new releases by themselves: systemctl --user enable --now podman-auto-update.timer

[Unit]
Description=photobook-db image library server

[Container]
# The released image for amd64 and arm64. For an image you built yourself, use localhost/photobook-db:latest
# and remove AutoUpdate.
Image=ghcr.io/oesusdevelopmentstudios/photobook-db:latest
AutoUpdate=registry
ContainerName=photobook-db
PublishPort=8737:8737

# Behind a reverse proxy such as Caddy (deploy/Caddyfile.example), only the proxy should reach the server.
# Use these two lines instead of the PublishPort above:
#PublishPort=127.0.0.1:8737:8737
#Environment=PHOTOBOOK_TRUSTED_PROXIES=*

# The database; a named volume keeps it when the image is updated.
Volume=photobook-data:/data

# The images, in a folder of your own. Create it before the first start: mkdir -p ~/Pictures/photobook-library
# :Z lets the container use it on systems with SELinux.
Volume=%h/Pictures/photobook-library:/library:Z

# The desktop app on this computer can then open an image's folder in the file manager: the host's machine ID
# shows it runs here, and the library's path is as above. No :Z here: the file is only read.
Volume=/etc/machine-id:/run/host/machine-id:ro
Environment=PHOTOBOOK_HOST_LIBRARY_DIR=%h/Pictures/photobook-library

# Optional: a folder that admins can import from. Without ro, an import can remove the originals.
#Volume=/srv/photos-inbox:/import:ro,Z

# The container runs as UID 1000; this maps your user to it, so files it writes belong to you.
UserNS=keep-id:uid=1000,gid=1000

# The image has no curl; Python's urllib does the same.
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8737/api/v1/server/info', timeout=5)"
HealthInterval=1m

[Service]
Restart=on-failure
# The first start downloads the image; on a Raspberry Pi that can take longer than systemd's 90 seconds.
TimeoutStartSec=900

[Install]
WantedBy=default.target
