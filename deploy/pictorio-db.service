#
# systemd user service for photobook-db installed with pipx (without a container). Copy this file to
# ~/.config/systemd/user/ and run:
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now photobook-db
#
# To start it at boot without logging in: loginctl enable-linger $USER

[Unit]
Description=photobook-db photo and video library server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/photobook-db serve

# Reachable from the other computers in the network. Behind a reverse proxy on this computer
# (deploy/Caddyfile.example), remove this line: the server then listens on 127.0.0.1 only.
Environment=PHOTOBOOK_HOST=0.0.0.0

# The defaults: the database in ~/.local/share/photobook-db, the photos and videos in ~/Pictures/photobook-library.
#Environment=PHOTOBOOK_LIBRARY_DIR=/srv/photobook-library
# Optional: a folder that admins can import from.
#Environment=PHOTOBOOK_IMPORT_DIR=/srv/photos-inbox

Restart=on-failure

[Install]
WantedBy=default.target
